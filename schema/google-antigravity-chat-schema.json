      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between SKILL.md and GEMINI.md in Google Antigravity Chat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEMINI.md defines permanent workspace rules and invariants, while SKILL.md packages reusable procedural workflows and helper scripts loaded on demand."
          }
        },
        {
          "@type": "Question",
          "name": "How does Antigravity Chat handle parallel or UI-heavy tasks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It delegates isolated subtasks to read-only research subagents, Chrome DevTools browser subagents, and parallel swarm workers via the Agent Manager."
          }
