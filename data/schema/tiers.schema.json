{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "tiers",
    "precedence_rule"
  ],
  "properties": {
    "precedence_rule": {
      "type": "string",
      "minLength": 1
    },
    "tiers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "tier",
          "name",
          "shortName",
          "discountPercent",
          "multiplier"
        ],
        "properties": {
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "multiplier": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
