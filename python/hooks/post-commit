#!/bin/bash
# Git post-commit hook: Auto-generate LAST-COMMIT-REPORT.md on every new commit
# Strict Repo Compliance: Zero emojis, zero em-dashes.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    exit 0
fi

if [ -f "$REPO_ROOT/python/generate_last_commit_report.py" ]; then
    python3 "$REPO_ROOT/python/generate_last_commit_report.py" > /dev/null 2>&1 || true
fi

if [ -f "$REPO_ROOT/python/generate_test_coverage_report.py" ]; then
    python3 "$REPO_ROOT/python/generate_test_coverage_report.py" > /dev/null 2>&1 || true
fi

exit 0

