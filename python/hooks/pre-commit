#!/bin/bash
# Pre-commit hook: Auto-rebuild components, sync schemas, run unit tests,
# generate reports, and stage every generated file so the tree stays clean
# after the commit.
# Strict Repo Compliance: Zero emojis, zero em-dashes.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    exit 0
fi

if git diff --cached --name-only | grep -E '^(header|footer)\.html$' > /dev/null 2>&1; then
    echo "[git pre-commit] Detected changes to header.html or footer.html. Rebuilding components..."
    python3 "$REPO_ROOT/python/build_components.py"
    git add "$REPO_ROOT"/*.html "$REPO_ROOT"/business-services/*.html "$REPO_ROOT"/personal-services/*.html "$REPO_ROOT"/claude-training/*.html "$REPO_ROOT"/google-training/*.html "$REPO_ROOT"/md-html-sync/
fi

# Always sync Markdown mirrors and HTML pages
python3 "$REPO_ROOT/python/md_html_sync.py" > /dev/null 2>&1
git add "$REPO_ROOT/md-html-sync" 2>/dev/null || true

# Always sync HTML JSON schemas into schema/
python3 "$REPO_ROOT/python/sync_schemas.py" > /dev/null 2>&1
git add "$REPO_ROOT/schema" 2>/dev/null || true

python3 "$REPO_ROOT/python/generate_metrics.py" > /dev/null 2>&1

# Run all unit tests before committing (with coverage instrumentation when available)
echo "[git pre-commit] Running unit test suite (tests/)..."
if python3 -c "import coverage" > /dev/null 2>&1; then
    python3 -m coverage run --source="$REPO_ROOT/nlp-fuzzy-expert,$REPO_ROOT/python" "$REPO_ROOT/python/run_tests.py"
else
    python3 "$REPO_ROOT/python/run_tests.py"
fi
TEST_STATUS=$?
if [ $TEST_STATUS -ne 0 ]; then
    echo "[git pre-commit] ERROR: Unit test suite failed with status $TEST_STATUS. Commit aborted."
    exit 1
fi

echo "[git pre-commit] Running JavaScript test suite (pricing-tests.js)..."
node "$REPO_ROOT/pricing-tests.js"
JS_TEST_STATUS=$?
if [ $JS_TEST_STATUS -ne 0 ]; then
    echo "[git pre-commit] ERROR: JavaScript test suite failed with status $JS_TEST_STATUS. Commit aborted."
    exit 1
fi

# Verify data directory Single Source of Truth (SSOT) integrity
DATA_DIR_STATUS="$(git status --porcelain "$REPO_ROOT/data" 2>/dev/null)"
if [ -n "$DATA_DIR_STATUS" ]; then
    echo "[git pre-commit] WARNING: Detected modified or untracked files in data/:"
    echo "$DATA_DIR_STATUS"
fi

echo "[git pre-commit] All unit and JavaScript tests passed. Generating reports..."

# Clean up any temporary failure reports generated by unit tests before computing metrics
rm -f "$REPO_ROOT"/failed_*.md 2>/dev/null || true

# ORDER MATTERS: the commit report overwrites LAST-COMMIT-REPORT.md,
# the coverage report then appends its section to it, generate_metrics.py
# updates METRICS.md, the README updater pulls the summary of updates from
# LAST-COMMIT-REPORT.md and METRICS.md into README.md, and generate_metrics.py
# runs a final pass so README.md line counts are exact.
if [ -f "$REPO_ROOT/python/generate_last_commit_report.py" ]; then
    python3 "$REPO_ROOT/python/generate_last_commit_report.py" > /dev/null 2>&1 || true
fi

if [ -f "$REPO_ROOT/python/generate_test_coverage_report.py" ]; then
    python3 "$REPO_ROOT/python/generate_test_coverage_report.py" > /dev/null 2>&1 || true
fi

python3 "$REPO_ROOT/python/generate_metrics.py" > /dev/null 2>&1 || true

if [ -f "$REPO_ROOT/python/update_readme_commit_summary.py" ]; then
    python3 "$REPO_ROOT/python/update_readme_commit_summary.py" > /dev/null 2>&1 || true
fi

# Regenerate METRICS.md after all markdown reports and README.md are updated
python3 "$REPO_ROOT/python/generate_metrics.py" > /dev/null 2>&1 || true

# The coverage script deletes the legacy report; stage the deletion if it was tracked
git rm -q --cached --ignore-unmatch -- "$REPO_ROOT/TEST_COVERAGE_REPORT.md" > /dev/null 2>&1 || true
rm -f "$REPO_ROOT"/failed_*.md 2>/dev/null || true

# Stage EVERYTHING the generators and tests may have written. This must come last.
git add -A -- "$REPO_ROOT/METRICS.md" "$REPO_ROOT/LAST-COMMIT-REPORT.md" "$REPO_ROOT/README.md" 2>/dev/null || true
git add -- "$REPO_ROOT/tests/.test_reports_cache.json" "$REPO_ROOT/tests/.js_test_reports_cache.json" 2>/dev/null || true
git add -- "$REPO_ROOT/nlp-fuzzy-expert"/*.md \
           "$REPO_ROOT/nlp-fuzzy-expert"/*_references.json \
           "$REPO_ROOT/nlp-fuzzy-expert/references_dictionary.json" \
           "$REPO_ROOT/nlp-fuzzy-expert/references_manifest.json" \
           "$REPO_ROOT/nlp-fuzzy-expert/sync_manifest.json" 2>/dev/null || true
git add -- "$REPO_ROOT/md-html-sync" "$REPO_ROOT/schema" 2>/dev/null || true
git add -u 2>/dev/null || true

# Diagnostic: list tracked files that are still modified but not staged.
# Anything printed here will remain dirty after the commit; add its path to the staging block above.
LEFTOVER="$(git diff --name-only 2>/dev/null)"
if [ -n "$LEFTOVER" ]; then
    echo "[git pre-commit] WARNING: tracked files modified but NOT staged (will stay dirty after commit):"
    echo "$LEFTOVER"
fi

echo "[git pre-commit] Commit approved."
exit 0