#!/bin/bash
# Pre-commit hook (SSOT Build Pipeline):
# Runs validate.py, build_components.py, render.py, md_html_sync.py,
# render.py --check, and Python/JS/HTML tests with visible output.
# Strict Repo Compliance: Zero emojis, zero em-dashes.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    exit 0
fi

echo "[git pre-commit] 1. Validating data/*.json schemas and invariants..."
python3 "$REPO_ROOT/python/ssot/validate.py"

STAGED_FILES="$(git diff --cached --name-only 2>/dev/null || true)"

if echo "$STAGED_FILES" | grep -E '^(header|footer)\.html$' > /dev/null 2>&1; then
    echo "[git pre-commit] 2. Rebuilding header/footer components..."
    python3 "$REPO_ROOT/python/build_components.py"
    git add "$REPO_ROOT"/*.html "$REPO_ROOT"/business-services/*.html "$REPO_ROOT"/personal-services/*.html "$REPO_ROOT"/claude-training/*.html "$REPO_ROOT"/gemini-training/*.html "$REPO_ROOT"/md-html-sync/
fi

echo "[git pre-commit] 3. Rendering SSOT markers and exporting site-data.json..."
python3 "$REPO_ROOT/python/ssot/render.py"
python3 "$REPO_ROOT/python/ssot/export_site_data.py"

if echo "$STAGED_FILES" | grep -E '\.(html|md)$|^data/.*\.json$' > /dev/null 2>&1; then
    echo "[git pre-commit] 4. Syncing Markdown mirrors and JSON-LD schemas..."
    python3 "$REPO_ROOT/python/md_html_sync.py"
    git add "$REPO_ROOT/md-html-sync"

    python3 "$REPO_ROOT/python/sync_schemas.py"
    git add "$REPO_ROOT/schema"
fi

echo "[git pre-commit] 5. Verifying SSOT markers (--check)..."
python3 "$REPO_ROOT/python/ssot/render.py" --check

echo "[git pre-commit] 6. Running Python, JavaScript, and HTML UI tests..."
python3 "$REPO_ROOT/python/run_tests.py"
node "$REPO_ROOT/pricing-tests.js"
python3 "$REPO_ROOT/python/run_html_tests.py"

git add -- "$REPO_ROOT/tests/.test_reports_cache.json" "$REPO_ROOT/tests/.js_test_reports_cache.json" "$REPO_ROOT/tests/.html_ui_test_reports_cache.json" "$REPO_ROOT/assets/data/site-data.json" 2>/dev/null || true

echo "[git pre-commit] Commit approved."
exit 0
