#!/bin/bash
# Pre-commit hook (Phase 0 - Frozen old sync):
# Runs build_components.py, md_html_sync.py, sync_schemas.py, and existing tests
# with visible output. A failing step aborts the commit.
# Strict Repo Compliance: Zero emojis, zero em-dashes.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    exit 0
fi

STAGED_FILES="$(git diff --cached --name-only 2>/dev/null || true)"

if echo "$STAGED_FILES" | grep -E '^(header|footer)\.html$' > /dev/null 2>&1; then
    echo "[git pre-commit] Detected changes to header.html or footer.html. Rebuilding components..."
    python3 "$REPO_ROOT/python/build_components.py"
    git add "$REPO_ROOT"/*.html "$REPO_ROOT"/business-services/*.html "$REPO_ROOT"/personal-services/*.html "$REPO_ROOT"/claude-training/*.html "$REPO_ROOT"/gemini-training/*.html "$REPO_ROOT"/md-html-sync/
fi

if echo "$STAGED_FILES" | grep -E '\.(html|md)$|^data/.*\.json$' > /dev/null 2>&1; then
    echo "[git pre-commit] Syncing Markdown mirrors and JSON-LD schemas for staged content changes..."
    python3 "$REPO_ROOT/python/md_html_sync.py"
    git add "$REPO_ROOT/md-html-sync"

    python3 "$REPO_ROOT/python/sync_schemas.py"
    git add "$REPO_ROOT/schema"
else
    echo "[git pre-commit] No HTML/MD/data changes staged; skipping redundant schema & Markdown sync."
fi

echo "[git pre-commit] Running Python unit tests..."
python3 "$REPO_ROOT/python/run_tests.py"

echo "[git pre-commit] Running JavaScript unit tests..."
node "$REPO_ROOT/pricing-tests.js"

echo "[git pre-commit] Running HTML UI tests..."
python3 "$REPO_ROOT/python/run_html_tests.py"

git add -- "$REPO_ROOT/tests/.test_reports_cache.json" "$REPO_ROOT/tests/.js_test_reports_cache.json" "$REPO_ROOT/tests/.html_ui_test_reports_cache.json" 2>/dev/null || true

echo "[git pre-commit] Commit approved."
exit 0
